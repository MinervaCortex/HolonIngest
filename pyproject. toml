[build-system]
requires = ["setuptools>=61.0"]
build-backend = "setuptools.build_meta"

[project]
name = "holoningest"
version = "0.1.0"
description = "Zero-Code Dynamic Ingestion Engine for Holonic Knowledge Graphs"
readme = "README.md"
requires-python = ">=3.10"
dependencies = [
    "fastapi>=0.100.0",
    "uvicorn[standard]>=0.22.0",
    "pydantic>=2.0.0",
    "pyjsonata>=0.0.1a8",
    "pyarrow>=12.0.0",
    "duckdb>=0.8.0",
    "xmltodict>=0.13.0"
]

# This registers the executable command line interface (CLI)
[project.scripts]
holoningest-server = "holoningest.cli:main"
